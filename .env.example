# ============================================================
# 把这个文件复制一份，改名为 .env ，然后填入你的 Key / 凭证。
# 不填任何内容也没关系：系统会自动用"规则/模板 + 本地官方知识库"兜底，
# 照样能跑通全链路（场景解析 → 平台策略 → 检索 → 软文生成 → 核验 → 合规）做演示。
# ============================================================

# ---------- 1) 大模型（可选，任何"OpenAI 兼容"接口都能用） ----------
# 不填 = 离线模式（MockLLM，用模板生成，不走网络）
LLM_API_KEY=
# 接口地址（默认 DeepSeek；换成别的厂商就改这里）
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名（默认 deepseek-chat）
LLM_MODEL=deepseek-chat

# ---------- 2) ima 知识库（可选，赛题要求的正式接入方式） ----------
# 填入后：系统会通过官方脚本 node ima-skill/ima_api.cjs 调用 ima 开放接口
#   接口顺序：search_knowledge_base → get_knowledge_list → search_knowledge → get_media_info
# 不填：自动回退到本地已解压的官方知识库 _official_kb/华为PC全板块深度知识库_v7，
#   图片同样取自知识库内的"图片索引.csv"，保证"图片来自知识库且型号一致"。
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=

# 更高版本兼容写法（部分环境用这套变量名，留空即可）
# IMA_CLIENT_ID=
# IMA_API_KEY=

# 说明：
#   - 官方脚本 ima-skill/ima_api.cjs 来自 ima-skills-1.1.10.zip，解压后放到项目根目录的 ima-skill/ 下即可。
#   - 知识库名称固定为 "任德耀新建华为PC知识库"（见 src/tools/ima_api.py 的 KB_NAME）。
#   - 安全提示：不要把真实 API Key / 凭证写进源码、README、截图或讲解视频里。
